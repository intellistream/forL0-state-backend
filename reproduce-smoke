#!/usr/bin/env bash
# Fast correctness gate for the offline benchmark environment and result path.
# This file must remain LF-only because it is executed directly on Linux.

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESULT_LAYOUT="${PROJECT_ROOT}/docker/lib/result_layout.sh"
[[ -f "$RESULT_LAYOUT" ]] || {
    echo "ERROR: missing result layout helper: $RESULT_LAYOUT" >&2
    exit 1
}
source "$RESULT_LAYOUT"
export FORL0_RUN_ID="${FORL0_RUN_ID:-smoke_$(date '+%Y%m%d_%H%M%S')}"
forl0_validate_run_id "$FORL0_RUN_ID"
if [[ -n "${FORL0_RESULTS_DIR:-}" ]]; then
    RESULTS_ROOT="$FORL0_RESULTS_DIR"
    [[ "$RESULTS_ROOT" == /* ]] || RESULTS_ROOT="${PROJECT_ROOT}/${RESULTS_ROOT}"
else
    RESULTS_BASE="$(forl0_results_base "$PROJECT_ROOT")"
    RESULTS_ROOT="${RESULTS_BASE}/runs/${FORL0_RUN_ID}/smoke"
    [[ ! -e "${RESULTS_BASE}/runs/${FORL0_RUN_ID}" ]] || {
        echo "ERROR: smoke output already exists: ${RESULTS_BASE}/runs/${FORL0_RUN_ID}" >&2
        exit 1
    }
fi
mkdir -p "$RESULTS_ROOT"
RESULTS_ROOT="$(cd "$RESULTS_ROOT" && pwd -P)"
export FORL0_RESULTS_DIR="$RESULTS_ROOT"
RUN_LOG="${FORL0_RUN_LOG:-$(dirname "$RESULTS_ROOT")/.logs}"
MARKER="$(mktemp /tmp/forl0-smoke-check.XXXXXX)"

cleanup() {
    rm -f "$MARKER"
}
trap cleanup EXIT

cd "$PROJECT_ROOT"
export FORL0_OFFLINE_ONLY=true
export FORL0_RUN_LOG="$RUN_LOG"
export FORL0_RUN_STARTED_EPOCH="${FORL0_RUN_STARTED_EPOCH:-$(date '+%s')}"

if ! bash ./run-forl0-offline.sh --smoke-only --skip-docker-load --no-report; then
    echo "SMOKE FAILED: launcher returned a non-zero status" | tee -a "$RUN_LOG"
    exit 1
fi

new_raw_count="$(
    find "${RESULTS_ROOT}/raw" \
        -type f \
        -name 'client_usecase_*.json' \
        -newer "$MARKER" \
        -print | wc -l
)"
if (( new_raw_count < 2 )); then
    echo "SMOKE FAILED: expected two new Client Usecase JSON files, found ${new_raw_count}" | tee -a "$RUN_LOG"
    exit 1
fi

new_nexmark_count="$(
    find "${RESULTS_ROOT}" \
        -mindepth 2 \
        -maxdepth 2 \
        -type f \
        -path '*/nexmark_*/nexmark_results.json' \
        -newer "$MARKER" \
        -print | wc -l
)"
if (( new_nexmark_count < 1 )); then
    echo "SMOKE FAILED: expected a fresh NexMark result, found ${new_nexmark_count}" | tee -a "$RUN_LOG"
    exit 1
fi

wrong_root="/root/forl0-runtime/benchmark/results"
if [[ -d "$wrong_root" ]] && find "$wrong_root" -type f -newer "$MARKER" -print -quit | grep -q .; then
    echo "SMOKE FAILED: new output was written under ${wrong_root}" | tee -a "$RUN_LOG"
    exit 1
fi

echo "SMOKE PASSED: environment, both backends, NexMark runtime, and result path are valid" | tee -a "$RUN_LOG"
