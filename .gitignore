# Maven build outputs
target/
*.jar
*.war
*.ear
*.class

# Maven wrapper
!.mvn/wrapper/maven-wrapper.jar

# Docker image for offline deployment
!docker/images/*.tar

# Pre-built JAR for offline server deployment
!docker/deploy/*.jar

# Nexmark distribution for offline deployment
!docker/deploy/nexmark-flink/
!docker/deploy/nexmark-flink/**

!**/src/main/**/target/
!**/src/test/**/target/

### IntelliJ IDEA ###
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
*.iws
*.iml
*.ipr

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/

### VS Code ###
.vscode/

### Mac OS ###
.DS_Store

### Benchmark ###
# Benchmark results are retained as experiment evidence.
/.reproduce-all.pid
/src/main/native/.forl0-source.sha256

# Results directory at root level
/results/

# Local-only derived analysis. Experiment servers upload raw/log evidence only;
# figures and PDFs are regenerated on an analysis workstation.
/output/
/tmp/

# External JARs (download manually)
benchmark/lib/*.jar

# External tools (download manually)
benchmark/tools/

# Python
benchmark/scripts/__pycache__/
benchmark/scripts/utils/__pycache__/
*.pyc
.venv/
venv/
.venv-benchmark/

# Flink source code (for VTune debugging)
flink-source/
# Runtime-extracted offline tools
tools/async-profiler*/
docker/generated/
docker/forl0-local.env
docker/hs_err_pid*.log
docker/deploy/*/log/

# Downloaded/generated offline release payloads.
# Canonical archives and checksums are distributed through GitHub Releases.
/forl0-offline-linux-arm64-py310-*.tar.gz
/forl0-offline-linux-arm64-py310-*.tar.gz.sha256
/forl0-offline-linux-arm64-py310-*/
/.idea
benchmark/results/figures/improvement_summary.pdf
benchmark/results/figures/improvement_summary.png
benchmark/results/figures/wordcount_throughput.pdf
benchmark/results/figures/wordcount_throughput.png

# Reproducible LaTeX build metadata (keep source, bibliography, and final PDFs).
research_paper/**/*.aux
research_paper/**/*.blg
research_paper/**/*.log
research_paper/**/*.fls
research_paper/**/*.fdb_latexmk
