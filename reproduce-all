#!/usr/bin/env bash
# One-command, disconnect-safe launcher for the complete offline benchmark suite.
# This file must remain LF-only because it is executed directly on Linux.

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="${PROJECT_ROOT}/.reproduce-all.pid"
RUN_LOG="${PROJECT_ROOT}/benchmark/results/.logs"

if [[ "${1:-}" == "--worker" ]]; then
    printf '%s\n' "$$" > "$PID_FILE"
    cleanup() {
        rm -f "$PID_FILE"
    }
    trap cleanup EXIT INT TERM

    # Capture the complete worker lifecycle, including failures that happen
    # before run-forl0-offline.sh installs its own tee. Nested launchers write
    # to /dev/null and flow through this single append-only stream, avoiding
    # duplicated log lines and preserving earlier runs.
    mkdir -p "$(dirname "$RUN_LOG")"
    exec >>"$RUN_LOG" 2>&1
    export FORL0_OFFLINE_ONLY=true
    export FORL0_RUN_ID="${FORL0_RUN_ID:-$(date '+%Y%m%d_%H%M%S')}"
    export FORL0_RUN_STARTED_EPOCH="${FORL0_RUN_STARTED_EPOCH:-$(date '+%s')}"
    export FORL0_RUN_LOG=/dev/null
    # A formal L0-server run must fail visibly instead of silently falling
    # back when one parallel engine cannot obtain its assigned L0 quota.
    export FORL0_L0_STRICT_OVERRIDE="${FORL0_L0_STRICT_OVERRIDE:-true}"
    cd "$PROJECT_ROOT"

    echo ""
    echo "=== reproduce-all RUN_ID=${FORL0_RUN_ID} started=$(date '+%Y-%m-%d %H:%M:%S %z') ==="
    bash ./reproduce-smoke
    echo "SMOKE PASSED: starting the complete W01-W02, N01-N14, C01-C08 suite"

    FORL0_RUN_LOG_MODE=append bash ./run-forl0-offline.sh \
        --reproduce-ascend \
        --keep-going \
        --skip-docker-load
    exit $?
fi

if [[ -f "$PID_FILE" ]]; then
    existing_pid="$(tr -d '[:space:]' < "$PID_FILE")"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" 2>/dev/null; then
        echo "完整性能测试已在运行，PID=${existing_pid}"
        echo "日志：${RUN_LOG}"
        exit 0
    fi
    rm -f "$PID_FILE"
fi

nohup "$0" --worker >/dev/null 2>&1 &
worker_pid=$!

echo "完整性能测试已后台启动，PID=${worker_pid}（先 smoke，通过后自动跑全量）"
echo "日志：${RUN_LOG}"
echo "结果：${PROJECT_ROOT}/benchmark/results"
